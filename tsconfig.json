{
  // Check-only setup for the bundled ESM/TypeScript codebase.
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,
    "allowImportingTsExtensions": true,
    "lib": ["es2023", "dom"],
    "types": ["firefox-webext-browser", "save-in-chrome"],
    "typeRoots": ["./dist/types", "./node_modules/@types", "./node_modules"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true
  },
  "files": ["test/contracts/host-firefox.ts"],
  "include": ["src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["types/host-chrome.d.ts"]
}
